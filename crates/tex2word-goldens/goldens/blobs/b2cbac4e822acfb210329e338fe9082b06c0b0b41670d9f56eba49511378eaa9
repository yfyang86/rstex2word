          },
          {
            "@type": "Text",
            "value": " of "
          },
          {
            "@type": "Math",
            "latex": "G"
          },
          {
            "@type": "Text",
            "value": " containing "
          },
          {
            "@type": "Math",
            "latex": "a"
          },
          {
            "@type": "Text",
            "value": " is given as "
          },
          {
            "@type": "Math",
            "latex": "\\mathcal{O}_a=\\{g \\cdot a\\ |\\ g\\in G\\}"
          },
          {
            "@type": "LineBreak"
          },
          {
            "@type": "Text",
            "value": " • The action of "
          },
          {
            "@type": "Math",
            "latex": "G"
          },
          {
            "@type": "Text",
            "value": " on "
          },
          {
            "@type": "Math",
            "latex": "A"
          },
          {
            "@type": "Text",
            "value": " is called transitive if there is only one orbit."
          },
          {
            "@type": "LineBreak"
          },
          {
            "@type": "Text",
            "value": " • "
          },
          {
            "@type": "Emphasis",
            "inlines": [
              {
                "@type": "Text",
                "value": "Conjugacy classes"
              }
            ],
            "kind_": "bold"
          },
          {
            "@type": "Text",
            "value": " of G is the equivalence classes of G when it acts on itself with conjugation. i.e. "
          },
          {
            "@type": "Math",
            "latex": "{gag^{-1}\\ |\\ g \\in G }"
          }
        ]
      },
      {
        "@type": "Heading",
        "appendix": false,
        "inlines": [
          {
            "@type": "Text",
            "value": "Equivalence Classes and Orbits"
          }
        ],
        "label": null,
        "level": 2,
        "numbered": false,
        "part": false
      },
      {
        "@type": "Paragraph",
        "align": null,
        "inlines": [
          {
            "@type": "Emphasis",
            "inlines": [
              {
                "@type": "Text",
                "value": "Class equation"
              }
            ],
            "kind_": "bold"
          },
          {
            "@type": "Text",
            "value": " of a finite group "
          },
          {
            "@type": "Math",
            "latex": "G"
          },
          {
            "@type": "Text",
            "value": " is written as:"
          },
          {
            "@type": "LineBreak"
          },
          {
            "@type": "Text",
            "value": " "
          },
          {
            "@type": "Math",
            "latex": "|G|=|Z(G)|+|\\sum(\\text{Conjugancy classes of G})|"
          },
          {
            "@type": "LineBreak"
          },
          {
            "@type": "Text",
            "value": " "
          },
          {
            "@type": "Emphasis",
            "inlines": [
              {
                "@type": "Text",
                "value": "Oribit-stabilizer Theorem:"
              }
            ],
            "kind_": "bold"
          },
          {
            "@type": "LineBreak"
          },
          {
            "@type": "Text",
            "value": " For a group "
          },
          {
            "@type": "Math",
            "latex": "G"
          },
          {
            "@type": "Text",
            "value": " acting on a set "
          },
          {
            "@type": "Math",
            "latex": "S"
          },
          {
            "@type": "Text",
            "value": ", for any "
          },
          {
            "@type": "Math",
            "latex": "s\\ \\in\\ S"
          },
          {
            "@type": "Text",
            "value": " we have, "
          },
          {
            "@type": "Math",
            "latex": "|\\mathcal{O}_s||G_s|=|G|"
          }
        ]
      },
      {
        "@type": "Heading",
        "appendix": false,
        "inlines": [
          {
            "@type": "Text",
            "value": "Class equations and Orbit-stabilizer Theorem"
          }
        ],
        "label": null,
        "level": 2,
        "numbered": false,
        "part": false
      },
      {
        "@type": "Paragraph",
        "align": null,
        "inlines": [
          {
            "@type": "Emphasis",
            "inlines": [
              {
                "@type": "Text",
                "value": "Cayley's Theorem:"
              }
            ],
            "kind_": "bold"
          },
          {
            "@type": "LineBreak"
          },
          {
            "@type": "Text",
            "value": " Every group is isomorphic to a subgroup of some symmetric group. If "
          },
          {
            "@type": "Math",
            "latex": "G"
          },
          {
            "@type": "Text",
            "value": " is a group of order "
          },
          {
            "@type": "Math",
            "latex": "n"
          },
          {
            "@type": "Text",
            "value": ", then G is isomoprhic to a subgroup of "
          },
          {
            "@type": "Math",
            "latex": "S_n"
          }
        ]
      },
      {
        "@type": "Heading",
        "appendix": false,
        "inlines": [
          {
            "@type": "Text",
            "value": "Cayley's Theorem"
          }
        ],
        "label": null,
        "level": 2,
        "numbered": false,
        "part": false
      },
      {
        "@type": "Paragraph",
        "align": null,
        "inlines": [
          {
            "@type": "Emphasis",
            "inlines": [
              {
                "@type": "Text",
                "value": "Automorphism"
              }
            ],
            "kind_": "bold"
          },
          {
            "@type": "Text",
            "value": " of "
          },
          {
            "@type": "Math",
            "latex": "G"
          },
          {
            "@type": "Text",
            "value": " is defined as an isomorphism from "
          },
          {
            "@type": "Math",
            "latex": "G"
          },
          {
            "@type": "Text",
            "value": " onto itself."
          },
          {
            "@type": "LineBreak"
          },
          {
            "@type": "Text",
            "value": " The set of all automorphisms of "
          },
          {
            "@type": "Math",
            "latex": "G"
          },
          {
            "@type": "Text",
            "value": " is denoted by Aut("
          },
          {
            "@type": "Math",
            "latex": "G"
          },
          {
            "@type": "Text",
            "value": ")"
          }
        ]
      },
      {
        "@type": "Heading",
        "appendix": false,
        "inlines": [
          {
            "@type": "Text",
            "value": "Automorphisms"
          }
        ],
        "label": null,
        "level": 2,
        "numbered": false,
        "part": false
      },
      {
        "@type": "Paragraph",
        "align": null,
        "inlines": [
          {
            "@type": "Emphasis",
            "inlines": [
              {
                "@type": "Text",
                "value": "• p-group"
              }
            ],
            "kind_": "bold"
          },
          {
            "@type": "Text",
            "value": " is defined as a group of order "
          },
          {
            "@type": "Math",
            "latex": "p^a"
          },
          {
            "@type": "Text",
            "value": " for some "
          },
          {
            "@type": "Math",
            "latex": "a \\geq 1"
          },
          {
            "@type": "Text",
            "value": ". Sub-groups of "
          },
          {
            "@type": "Math",
            "latex": "G"
          },
          {
            "@type": "Text",
            "value": " which are p-groups are called p-subgroups."
          },
          {
            "@type": "LineBreak"
          },
          {
            "@type": "Text",
            "value": " "
          },
          {
            "@type": "Emphasis",
            "inlines": [
              {
                "@type": "Text",
                "value": "• Sylow p-group"
              }
            ],
            "kind_": "bold"
          },
          {
            "@type": "Text",
            "value": " is defined as a group of order "
          },
          {
            "@type": "Math",
            "latex": "p^am"
          },
          {
            "@type": "Text",
            "value": ", where "
          },
          {
            "@type": "Math",
            "latex": "p \\nmid m"
          },
          {
            "@type": "Text",
            "value": ", a subgroup of order "
          },
          {
            "@type": "Math",
            "latex": "p^a"
          },
          {
            "@type": "Text",
            "value": " is called a Sylow p-subgroup of "
          },
          {
            "@type": "Math",
            "latex": "G"
          },
          {
            "@type": "Text",
            "value": ". "
          },
          {
            "@type": "Math",
            "latex": "Syl_p(G)"
          },
          {
            "@type": "Text",
            "value": " is the set of Sylow p-subgroups of "
          },
          {
            "@type": "Math",
            "latex": "G"
          },
          {
            "@type": "Text",
            "value": "."
          }
        ]
      },
      {
        "@type": "Heading",
        "appendix": false,
        "inlines": [
          {
            "@type": "Text",
            "value": "p-groups and Sylow p-groups"
          }
        ],
        "label": null,
        "level": 2,
        "numbered": false,
        "part": false
      },
      {
        "@type": "Paragraph",
        "align": null,
        "inlines": [
          {
            "@type": "Emphasis",
            "inlines": [
              {
                "@type": "Text",
                "value": "i. The First Sylow Theorem:"
              }
            ],
            "kind_": "bold"
          },
          {
            "@type": "LineBreak"
          },
          {
            "@type": "Text",
            "value": " If "
          },
          {
            "@type": "Math",
            "latex": "p"
          },
          {
            "@type": "Text",
            "value": " divides "
          },
          {
            "@type": "Math",
            "latex": "|G|"
          },
          {
            "@type": "Text",
            "value": ", then "
          },
          {
            "@type": "Math",
            "latex": "G"
          },
          {
            "@type": "Text",
            "value": " has a Sylow p-subgroup."
          },
          {
            "@type": "LineBreak"
          },
          {
            "@type": "Text",
            "value": " "
          },
          {
            "@type": "Emphasis",
            "inlines": [
              {
                "@type": "Text",
                "value": "ii. The Second Sylow Theorem:"
              }
            ],
            "kind_": "bold"
          },
          {
            "@type": "LineBreak"
          },
          {
            "@type": "Text",
            "value": " All Sylow p-subgroups of "
          },
          {
            "@type": "Math",
            "latex": "G"
          },
          {
            "@type": "Text",
            "value": " are conjugate to each other for a fixed "
          },
          {
            "@type": "Math",
            "latex": "p"
          },
          {
            "@type": "Text",
            "value": "."
          },
          {
            "@type": "LineBreak"
          },
          {
            "@type": "Text",
            "value": " "
          },
          {
            "@type": "Emphasis",
            "inlines": [
              {
                "@type": "Text",
                "value": "iii. The Third Sylow Theorem:"
              }
            ],
            "kind_": "bold"
          },
          {
            "@type": "LineBreak"
          },
          {
            "@type": "Text",
            "value": " "
          },
          {
            "@type": "Math",
            "latex": "n_p \\equiv 1 (\\text{mod}\\ p)"
          },
          {
            "@type": "Text",
            "value": ", where "
          },
          {
            "@type": "Math",
            "latex": "n_p"
          },
          {
            "@type": "Text",
            "value": " is the number of Sylow p-subgroups of G."
          }
        ]
      },
      {
        "@type": "Heading",
        "appendix": false,
        "inlines": [
          {
            "@type": "Text",
            "value": "The Sylow Theorems"
          }
        ],
