lso in G</w:t></w:r><w:r><w:br/></w:r><w:r><w:t xml:space="preserve"> </w:t></w:r><w:r><w:rPr><w:b/></w:rPr><w:t xml:space="preserve">ii. Associativity:</w:t></w:r><w:r><w:t xml:space="preserve"> (a * b) * c = a * (b * c), </w:t></w:r><m:oMath><m:r><m:rPr><m:nor/></m:rPr><m:t xml:space="preserve">∀</m:t></m:r></m:oMath><w:r><w:t xml:space="preserve"> a, b, c </w:t></w:r><m:oMath><m:r><m:rPr><m:nor/></m:rPr><m:t xml:space="preserve">∈</m:t></m:r></m:oMath><w:r><w:t xml:space="preserve"> G</w:t></w:r><w:r><w:br/></w:r><w:r><w:t xml:space="preserve"> </w:t></w:r><w:r><w:rPr><w:b/></w:rPr><w:t xml:space="preserve">iii. Identity:</w:t></w:r><w:r><w:t xml:space="preserve"> </w:t></w:r><m:oMath><m:r><m:rPr><m:nor/></m:rPr><m:t xml:space="preserve">∃</m:t></m:r></m:oMath><w:r><w:t xml:space="preserve"> e </w:t></w:r><m:oMath><m:r><m:rPr><m:nor/></m:rPr><m:t xml:space="preserve">∈</m:t></m:r></m:oMath><w:r><w:t xml:space="preserve"> G, called an identity of G,</w:t></w:r><w:r><w:br/></w:r><w:r><w:t xml:space="preserve"> s.t. </w:t></w:r><m:oMath><m:r><m:rPr><m:nor/></m:rPr><m:t xml:space="preserve">∀</m:t></m:r></m:oMath><w:r><w:t xml:space="preserve"> a </w:t></w:r><m:oMath><m:r><m:rPr><m:nor/></m:rPr><m:t xml:space="preserve">∈</m:t></m:r></m:oMath><w:r><w:t xml:space="preserve"> G we have a * e = e * a = a</w:t></w:r><w:r><w:br/></w:r><w:r><w:t xml:space="preserve"> </w:t></w:r><w:r><w:rPr><w:b/></w:rPr><w:t xml:space="preserve">iv. Inverse</w:t></w:r><w:r><w:t xml:space="preserve"> </w:t></w:r><m:oMath><m:r><m:rPr><m:nor/></m:rPr><m:t xml:space="preserve">∀</m:t></m:r></m:oMath><w:r><w:t xml:space="preserve"> a </w:t></w:r><m:oMath><m:r><m:rPr><m:nor/></m:rPr><m:t xml:space="preserve">∈</m:t></m:r></m:oMath><w:r><w:t xml:space="preserve"> G </w:t></w:r><m:oMath><m:r><m:rPr><m:nor/></m:rPr><m:t xml:space="preserve">∃</m:t></m:r><m:r><m:rPr><m:nor/></m:rPr><m:t xml:space="preserve"> </m:t></m:r><m:sSup><m:e><m:r><m:t xml:space="preserve">a</m:t></m:r></m:e><m:sup><m:r><m:r