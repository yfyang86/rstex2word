<w:b/></w:rPr><w:t xml:space="preserve">Oribit-stabilizer Theorem:</w:t></w:r><w:r><w:br/></w:r><w:r><w:t xml:space="preserve"> For a group </w:t></w:r><m:oMath><m:r><m:t xml:space="preserve">G</m:t></m:r></m:oMath><w:r><w:t xml:space="preserve"> acting on a set </w:t></w:r><m:oMath><m:r><m:t xml:space="preserve">S</m:t></m:r></m:oMath><w:r><w:t xml:space="preserve">, for any </w:t></w:r><m:oMath><m:r><m:t xml:space="preserve">s</m:t></m:r><m:r><m:rPr><m:nor/></m:rPr><m:t xml:space="preserve"> </m:t></m:r><m:r><m:rPr><m:nor/></m:rPr><m:t xml:space="preserve">∈</m:t></m:r><m:r><m:rPr><m:nor/></m:rPr><m:t xml:space="preserve"> </m:t></m:r><m:r><m:t xml:space="preserve">S</m:t></m:r></m:oMath><w:r><w:t xml:space="preserve"> we have, </w:t></w:r><m:oMath><m:r><m:rPr><m:nor/></m:rPr><m:t xml:space="preserve">|</m:t></m:r><m:sSub><m:e><m:r><m:rPr><m:scr m:val="script"/><m:sty m:val="p"/></m:rPr><m:t xml:space="preserve">O</m:t></m:r></m:e><m:sub><m:r><m:t xml:space="preserve">s</m:t></m:r></m:sub></m:sSub><m:r><m:rPr><m:nor/></m:rPr><m:t xml:space="preserve">|</m:t></m:r><m:r><m:rPr><m:nor/></m:rPr><m:t xml:space="preserve">|</m:t></m:r><m:sSub><m:e><m:r><m:t xml:space="preserve">G</m:t></m:r></m:e><m:sub><m:r><m:t xml:space="preserve">s</m:t></m:r></m:sub></m:sSub><m:r><m:rPr><m:nor/></m:rPr><m:t xml:space="preserve">|</m:t></m:r><m:r><m:rPr><m:nor/></m:rPr><m:t xml:space="preserve">=</m:t></m:r><m:r><m:rPr><m:nor/></m:rPr><m:t xml:space="preserve">|</m:t></m:r><m:r><m:t xml:space="preserve">G</m:t></m:r><m:r><m:rPr><m:nor/></m:rPr><m:t xml:space="preserve">|</m:t></m:r></m:oMath></w:p><w:p><w:pPr><w:pStyle w:val="Heading2"/></w:pPr><w:r><w:t xml:space="preserve">Class equations and Orbit-stabilizer Theorem</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="Normal"/></w:pPr><w:r><w:rPr><w:b/></w:rPr><w:t xml:space="preserve">Cayley's Theorem:</w:t></w:r><w:r><w:br/></w:r><w:r><w:t xml:space="preserve"> Every group is isomorphic to a subgroup of some symmetric group. If </w:t></w:r><m:oMath><m:r><m:t xml:space="preserve">G</m:t></m:r></m:oMath><w:r><w:t xml:space="preserve"> is a group of order </w:t></w:r><m:oMath><m:r><m:t xml:space="preserve">n</m:t></m:r></m:oMath><w:r><w:t xml:space="preserve">, then G is isomoprhic to a subgroup of </w:t></w:r><m:oMath><m:sSub><m:e><m:r><m:t xml:space="preserve">S</m:t></m:r></m:e><m:sub><m:r><m:t xml:space="preserve">n</m:t></m:r></m:sub></m:sSub></m:oMath></w:p><w:p><w:pPr><w:pStyle w:val="Heading2"/></w:pPr><w:r><w:t xml:space="preserve">Cayley's Theorem</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="Normal"/></w:pPr><w:r><w:rPr><w:b/></w:rPr><w:t xml:space="preserve">Automorphism</w:t></w:r><w:r><w:t xml:space="preserve"> of </w:t></w:r><m:oMath><m:r><m:t xml:space="preserve">G</m:t></m:r></m:oMath><w:r><w:t xml:space="preserve"> is defined as an isomorphism from </w:t></w:r><m:oMath><m:r><m:t xml:space="preserve">G</m:t></m:r></m:oMath><w:r><w:t xml:space="preserve"> onto itself.</w:t></w:r><w:r><w:br/></w:r><w:r><w:t xml:space="preserve"> The set of all automorphisms of </w:t></w:r><m:oMath><m:r><m:t xml:space="preserve">G</m:t></m:r></m:oMath><w:r><w:t xml:space="preserve"> is denoted by Aut(</w:t></w:r><m:oMath><m:r><m:t xml:space="preserve">G</m:t></m:r></m:oMath><w:r><w:t xml:space="preserve">)</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="Heading2"/></w:pPr><w:r><w:t xml:space="preserve">Automorphisms</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="Normal"/></w:pPr><w:r><w:rPr><w:b/></w:rPr><w:t xml:space="preserve">• p-group</w:t></w:r><w:r><w:t xml:space="preserve"> is defined as a group of order </w:t></w:r><m:oMath><m:sSup><m:e><m:r><m:t xml:space="preserve">p</m:t></m:r></m:e><m:sup><m:r><m:t xml:space="preserve">a</m:t></m:r></m:sup></m:sSup></m:oMath><w:r><w:t xml:space="preserve"> for some </w:t></w:r><m:oMath><m:r><m:t xml:space="preserve">a</m:t></m:r><m:r><m:rPr><m:nor/></m:rPr><m:t xml:space="preserve">≥</m:t></m:r><m:r><m:rPr><m:nor/></m:rPr><m:t xml:space="preserve">1</m:t></m:r></m:oMath><w:r><w:t xml:space="preserve">. Sub-groups of </w:t></w:r><m:oMath><m:r><m:t xml:space="preserve">G</m:t></m:r></m:oMath><w:r><w:t xml:space="preserve"> which are p-groups are called p-subgroups.</w:t></w:r><w:r><w:br/></w:r><w:r><w:t xml:space="preserve"> </w:t></w:r><w:r><w:rPr><w:b/></w:rPr><w:t xml:space="preserve">• Sylow p-group</w:t></w:r><w:r><w:t xml:space="preserve"> is defined as a group of order </w:t></w:r><m:oMath><m:sSup><m:e><m:r><m:t xml:space="preserve">p</m:t></m:r></m:e><m:sup><m:r><m:t xml:space="preserve">a</m:t></m:r></m:sup></m:sSup><m:r><m:t xml:space="preserve">m</m:t></m:r></m:oMath><w:r><w:t xml:space="preserve">, where </w:t></w:r><m:oMath><m:r><m:t xml:space="preserve">p</m:t></m:r><m:r><m:rPr><m:nor/></m:rPr><m:t xml:space="preserve">∤</m:t></m:r><m:r><m:t xml:space="preserve">m</m:t></m:r></m:oMath><w:r><w:t xml:space="preserve">, a subgroup of order </w:t></w:r><m:oMath><m:sSup><m:e><m:r><m:t xml:space="preserve">p</m:t></m:r></m:e><m:sup><m:r><m:t xml:space="preserve">a</m:t></m:r></m:sup></m:sSup></m:oMath><w:r><w:t xml:space="preserve"> is called a Sylow p-subgroup of </w:t></w:r><m:oMath><m:r><m:t xml:space="preserve">G</m:t></m:r></m:oMath><w:r><w:t xml:space="preserve">. </w:t></w:r><m:oMath><m:r><m:t xml:space="preserve">S</m:t></m:r><m:r><m:t xml:space="preserve">y</m:t></m:r><m:sSub><m:e><m:r><m:t xml:space="preserve">l</m:t></m:r></m:e><m:sub><m:r><m:t xml:space="preserve">p</m:t></m:r></m:sub></m:sSub><m:r><m:rPr><m:nor/></m:rPr><m:t xml:space="preserve">(</m:t></m:r><m:r><m:t xml:space="preserve">G</m:t></m:r><m:r><m:rPr><m:nor/></m:rPr><m:t xml:space="preserve">)</m:t></m:r></m:oMath><w:r><w:t xml:space="preserve"> is the set of Sylow p-subgroups of </w:t></w:r><m:oMath><m:r><m:t xml:space="preserve">G</m:t></m:r></m:oMath><w:r><w:t xml:space="preserve">.</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="Heading2"/></w:pPr><w:r><w:t xml:space="preserve">p-groups and Sylow p-groups</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="Normal"/></w:pPr><w:r><w:rPr><w:b/></w:rPr><w:t xml:space="preserve">i. The First Sylow Theorem:</w:t></w:r><w:r><w:br/></w:r><w:r><w:t xml:space="preserve"> If </w:t></w:r><m:oMath><m:r><m:t xml:space="preserve">p</m:t></m:r></m:oMath><w:r><w:t xml:space="preserve"> divides </w:t></w:r><m:oMath><m:r><m:rPr><m:nor/></m:rPr><m:t xml:space="preserve">|</m:t></m:r><m:r><m:t xml:space="preserve">G</m:t></m:r><m:r><m:rPr><m:nor/></m:rPr><m:t xml:space="preserve">|</m:t></m:r></m:oMath><w:r><w:t xml:space="preserve">, then </w:t></w:r><m:oMath><m:r><m:t xml:space="preserve">G</m:t></m:r></m:oMath><w:r><w:t xml:space="preserve"> has a Sylow p-subgroup.</w:t></w:r><w:r><w:br/></w:r><w:r><w:t xml:space="preserve"> </w:t></w:r><w:r><w:rPr><w:b/></w:rPr><w:t xml:space="preserve">ii. The Second Sylow Theorem:</w:t></w:r><w:r><w:br/></w:r><w:r><w:t xml:space="preserve"> All Sylow p-subgroups of </w:t></w:r><m:oMath><m:r><m:t xml:space="preserve">G</m:t></m:r></m:oMath><w:r><w:t xml:space="preserve"> are conjugate to each other for a fixed </w:t></w:r><m:oMath><m:r><m:t xml:space="preserve">p</m:t></m:r></m:oMath><w:r><w:t xml:space="preserve">.</w:t></w:r><w:r><w:br/></w:r><w:r><w:t xml:space="preserve"> </w:t></w:r><w:r><w:rPr><w:b/></w:rPr><w:t xml:space="preserve">iii. The Third Sylow Theorem:</w:t></w:r><w:r><w:br/></w:r><w:r><w:t xml:space="preserve"> </w:t></w:r><m:oMath><m:sSub><m:e><m:r><m:t xml:space="preserve">n</m:t></m:r></m:e><m:sub><m:r><m:t xml:space="preserve">p</m:t></m:r></m:sub></m:sSub><m:r><m:rPr><m:nor/></m:rPr><m:t xml:space="preserve">≡</m:t></m:r><m:r><m:rPr><m:nor/></m:rPr><m:t xml:space="preserve">1</m:t></m:r><m:r><m:rPr><m:nor/></m:rPr><m:t xml:space="preserve">(</m:t></m:r><m:r><m:rPr><m:nor/></m:rPr><m:t xml:space="preserve">m</m:t></m:r><m:r><m:rPr><m:nor/></m:rPr><m:t xml:space="preserve">o</m:t></m:r><m:r><m:rPr><m:nor/></m:rPr><m:t xml:space="preserve">d</m:t></m:r><m:r><m:rPr><m:nor/></m:rPr><m:t xml:space="preserve"> </m:t></m:r><m:r><m:t xml:space="preserve">p</m:t></m:r><m:r><m:rPr><m:nor/></m:rPr><m:t xml:space="preserve">)</m:t></m:r></m:oMath><w:r><w:t xml:space="preserve">, where </w:t></w:r><m:oMath><m:sSub><m:e><m:r><m:t xml:space="preserve">n</m:t></m:r></m:e><m:sub><m:r><m:t xml:space="preserve">p</m:t></m:r></m:sub></m:sSub></m:oMath><w:r><w:t xml:space="preserve"> is the number of Sylow p-subgroups of G.</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="Heading2"/></w:pPr><w:r><w:t xml:space="preserve">The Sylow Theorems</w:t></w:r></w:p><w:sectPr><w:pgSz w:w="12240" w:h="15840"/><w:pgMar w:top="1440" w:right="1440" w:bottom="1440" w:left="1440" w:header="720" w:footer="720"/><w:cols w:num="3" w:space="720"/></w:sectPr></w:body></w:document>