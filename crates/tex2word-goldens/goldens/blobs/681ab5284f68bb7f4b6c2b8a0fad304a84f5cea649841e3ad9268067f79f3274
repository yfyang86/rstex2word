<w:document xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main" xmlns:m="http://schemas.openxmlformats.org/officeDocument/2006/math" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" xmlns:wp="http://schemas.openxmlformats.org/drawingml/2006/wordprocessingDrawing" xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main" xmlns:pic="http://schemas.openxmlformats.org/drawingml/2006/picture" xmlns:ct="http://schemas.openxmlformats.org/package/2006/content-types" xmlns:rel="http://schemas.openxmlformats.org/package/2006/relationships"><w:body><w:p><w:pPr><w:pStyle w:val="Title"/></w:pPr><w:r><w:t xml:space="preserve"> CLASS NAME </w:t></w:r><w:r><w:br/></w:r><w:r><w:t xml:space="preserve"> </w:t></w:r><w:r><w:rPr><w:b/></w:rPr><w:t xml:space="preserve">Assignment Name</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="Subtitle"/></w:pPr><w:r><w:t xml:space="preserve">Author Name </w:t></w:r><w:r><w:br/></w:r><w:r><w:t xml:space="preserve"> </w:t></w:r><w:r><w:br/></w:r><w:r><w:t xml:space="preserve"> </w:t></w:r><w:r><w:rPr><w:i/></w:rPr><w:t xml:space="preserve">Collaborators: Names</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="Subtitle"/></w:pPr><w:r><w:t xml:space="preserve">Due date, or some other relevant date</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="Heading1"/></w:pPr><w:r><w:t xml:space="preserve">Problem 13.3 of A&amp;A</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="Heading2"/></w:pPr><w:r><w:t xml:space="preserve">Part a)</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="Normal"/></w:pPr><w:r><w:rPr><w:b/></w:rPr><w:t xml:space="preserve">Claim</w:t></w:r><w:r><w:rPr><w:b/></w:rPr><w:t xml:space="preserve">. </w:t></w:r><m:oMath><m:rad><m:radPr><m:degHide m:val="1"/></m:radPr><m:deg/><m:e><m:r><m:rPr><m:nor/></m:rPr><m:t xml:space="preserve">2</m:t></m:r></m:e></m:rad></m:oMath><w:r><w:t xml:space="preserve"> is irrational.</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="Normal"/></w:pPr><w:r><w:rPr><w:i/></w:rPr><w:t xml:space="preserve">Proof</w:t></w:r><w:r><w:rPr><w:i/></w:rPr><w:t xml:space="preserve">. </w:t></w:r><w:r><w:t xml:space="preserve">Suppose that </w:t></w:r><m:oMath><m:rad><m:radPr><m:degHide m:val="1"/></m:radPr><m:deg/><m:e><m:r><m:rPr><m:nor/></m:rPr><m:t xml:space="preserve">2</m:t></m:r></m:e></m:rad></m:oMath><w:r><w:t xml:space="preserve"> were rational. There there exist some non-zero integers </w:t></w:r><m:oMath><m:r><m:t xml:space="preserve">p</m:t></m:r></m:oMath><w:r><w:t xml:space="preserve"> and </w:t></w:r><m:oMath><m:r><m:t xml:space="preserve">q</m:t></m:r></m:oMath><w:r><w:t xml:space="preserve"> such that</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="Normal"/></w:pPr><m:oMathPara><m:oMath><m:rad><m:radPr><m:degHide m:val="1"/></m:radPr><m:deg/><m:e><m:r><m:rPr><m:nor/></m:rPr><m:t xml:space="preserve">2</m:t></m:r></m:e></m:rad><m:r><m:rPr><m:nor/></m:rPr><m:t xml:space="preserve">=</m:t></m:r><m:f><m:num><m:r><m:t xml:space="preserve">p</m:t></m:r></m:num><m:den><m:r><m:t xml:space="preserve">q</m:t></m:r></m:den></m:f><m:r><m:rPr><m:nor/></m:rPr><m:t xml:space="preserve">.</m:t></m:r></m:oMath></m:oMathPara></w:p><w:p><w:pPr><w:pStyle w:val="Normal"/></w:pPr><w:r><w:t xml:space="preserve">Without loss of generality, we can assume that this fraction is simplified so that </w:t></w:r><m:oMath><m:r><m:t xml:space="preserve">p</m:t></m:r></m:oMath><w:r><w:t xml:space="preserve"> and </w:t></w:r><m:oMath><m:r><m:t xml:space="preserve">q</m:t></m:r></m:oMath><w:r><w:t xml:space="preserve"> have no common divisors. Then,</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="Normal"/></w:pPr><m:oMathPara><m:oMath><m:m><m:mPr><m:mcs><m:mc><m:mcPr><m:count m:val="1"/><m:mcJc m:val="right"/></m:mcPr></m:mc><m:mc><m:mcPr><m:count m:val="1"/><m:mcJc m:val="left"/></m:mcPr></m:mc></m:mcs></m:mPr><m:mr><m:e><m:rad><m:radPr><m:degHide m:val="1"/></m:radPr><m:deg/><m:e><m:r><m:rPr><m:nor/></m:rPr><m:t xml:space="preserve">2</m:t></m:r></m:e></m:rad><m:r><m:t xml:space="preserve">q</m:t></m:r></m:e><m:e><m:r><m:rPr><m:nor/></m:rPr><m:t xml:space="preserve">=</m:t></m:r><m:r><m:t xml:space="preserve">p</m:t></m:r></m:e></m:mr><m:mr><m:e><m:r><m:rPr><m:nor/></m:rPr><m:t xml:space="preserve">2</m:t></m:r><m:sSup><m:e><m:r><m:t xml:space="preserve">q</m:t></m:r></m:e><m:sup><m:r><m:rPr><m:nor/></m:rPr><m:t xml:space="preserve">2</m:t></m:r></m:sup></m:sSup></m:e><m:e><m:r><m:rPr><m:nor/></m:rPr><m:t xml:space="preserve">=</m:t></m:r><m:sSup><m:e><m:r><m:t xml:space="preserve">p</m:t></m:r></m:e><m:sup><m:r><m:rPr><m:nor/></m:rPr><m:t xml:space="preserve">2</m:t></m:r></m:sup></m:sSup><m:r><m:rPr><m:nor/></m:rPr><m:t xml:space="preserve">.</m:t></m:r></m:e></m:mr></m:m></m:oMath></m:oMathPara></w:p><w:p><w:pPr><w:pStyle w:val="Normal"/></w:pPr><w:r><w:t xml:space="preserve">This implies (by the fundamental theorem of arithmetic) that 2 divides </w:t></w:r><m:oMath><m:sSup><m:e><m:r><m:t xml:space="preserve">p</m:t></m:r></m:e><m:sup><m:r><m:rPr><m:nor/></m:rPr><m:t xml:space="preserve">2</m:t></m:r></m:sup></m:sSup></m:oMath><w:r><w:t xml:space="preserve"> and, hence, 2 divides </w:t></w:r><m:oMath><m:r><m:t xml:space="preserve">p</m:t></m:r><m:r><m:rPr><m:nor/></m:rPr><m:t xml:space="preserve">.</m:t></m:r></m:oMath><w:r><w:t xml:space="preserve"> Therefore, </w:t></w:r><m:oMath><m:r><m:t xml:space="preserve">p</m:t></m:r><m:r><m:rPr><m:nor/></m:rPr><m:t xml:space="preserve">=</m:t></m:r><m:r><m:rPr><m:nor/></m:rPr><m:t xml:space="preserve">2</m:t></m:r><m:r><m:t xml:space="preserve">r</m:t></m:r></m:oMath><w:r><w:t xml:space="preserve"> for some (non-zero) integer </w:t></w:r><m:oMath><m:r><m:t xml:space="preserve">r</m:t></m:r><m:r><m:rPr><m:nor/></m:rPr><m:t xml:space="preserve">.</m:t></m:r></m:oMath><w:r><w:t xml:space="preserve"> Therefore,</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="Normal"/></w:pPr><m:oMathPara><m:oMath><m:m><m:mPr><m:mcs><m:mc><m:mcPr><m:count m:val="1"/><m:mcJc m:val="right"/></m:mcPr></m:mc><m:mc><m:mcPr><m:count m:val="1"/><m:mcJc m:val="left"/></m:mcPr></m:mc></m:mcs></m:mPr><m:mr><m:e><m:r><m:rPr><m:nor/></m:rPr><m:t xml:space="preserve">2</m:t></m:r><m:sSup><m:e><m:r><m:t xml:space="preserve">q</m:t></m:r></m:e><m:sup><m:r><m:rPr><m:nor/></m:rPr><m:t xml:space="preserve">2</m:t></m:r></m:sup></m:sSup></m:e><m:e><m:r><m:rPr><m:nor/></m:rPr><m:t xml:space="preserve">=</m:t></m:r><m:sSup><m:e><m:r><m:t xml:space="preserve">p</m:t></m:r></m:e><m:sup><m:r><m:rPr><m:nor/></m:rPr><m:t xml:space="preserve">2</m:t></m:r></m:sup></m:sSup></m:e></m:mr><m:mr><m:e><m:r><m:rPr><m:nor/></m:rPr><m:t xml:space="preserve">2</m:t></m:r><m:sSup><m:e><m:r><m:t xml:space="preserve">q</m:t></m:r></m:e><m:sup><m:r><m:rPr><m:nor/></m:rPr><m:t xml:space="preserve">2</m:t></m:r></m:sup></m:sSup></m:e><m:e><m:r><m:rPr><m:nor/></m:rPr><m:t xml:space="preserve">=</m:t></m:r><m:r><m:rPr><m:nor/></m:rPr><m:t xml:space="preserve">(</m:t></m:r><m:r><m:rPr><m:nor/></m:rPr><m:t xml:space="preserve">2</m:t></m:r><m:r><m:t xml:space="preserve">r</m:t></m:r><m:sSup><m:e><m:r><m:rPr><m:nor/></m:rPr><m:t xml:space="preserve">)</m:t></m:r></m:e><m:sup><m:r><m:rPr><m:nor/></m:rPr><m:t xml:space="preserve">2</m:t></m:r></m:sup></m:sSup></m:e></m:mr><m:mr><m:e><m:r><m:rPr><m:nor/></m:rPr><m:t xml:space="preserve">2</m:t></m:r><m:sSup><m:e><m:r><m:t xml:space="preserve">q</m:t></m:r></m:e><m:sup><m:r><m:rPr><m:nor/></m:rPr><m:t xml:space="preserve">2</m:t></m:r></m:sup></m:sSup></m:e><m:e><m:r><m:rPr><m:nor/></m:rPr><m:t xml:space="preserve">=</m:t></m:r><m:r><m:rPr><m:nor/></m:rPr><m:t xml:space="preserve">4</m:t></m:r><m:sSup><m:e><m:r><m:t xml:space="preserve">r</m:t></m:r></m:e><m:sup><m:r><m:rPr><m:nor/></m:rPr><m:t xml:space="preserve">2</m:t></m:r></m:sup></m:sSup></m:e></m:mr><m:mr><m:e><m:sSup><m:e><m:r><m:t xml:space="preserve">q</m:t></m:r></m:e><m:sup><m:r><m:rPr><m:nor/></m:rPr><m:t xml:space="preserve">2</m:t></m:r></m:sup></m:sSup></m:e><m:e><m:r><m:rPr><m:nor/></m:rPr><m:t xml:space="preserve">=</m:t></m:r><m:r><m:rPr><m:nor/></m:rPr><m:t xml:space="preserve">2</m:t></m:r><m:sSup><m:e><m:r><m:t xml:space="preserve">r</m:t></m:r></m:e><m:sup><m:r><m:rPr><m:nor/></m:rPr><m:t xml:space="preserve">2</m:t></m:r></m:sup></m:sSup><m:r><m:rPr><m:nor/></m:rPr><m:t xml:space="preserve">.</m:t></m:r></m:e></m:mr></m:m></m:oMath></m:oMathPara></w:p><w:p><w:pPr><w:pStyle w:val="Normal"/></w:pPr><w:r><w:t xml:space="preserve">From this, we conclude that 2 divides </w:t></w:r><m:oMath><m:sSup><m:e><m:r><m:t xml:space="preserve">q</m:t></m:r></m:e><m:sup><m:r><m:rPr><m:nor/></m:rPr><m:t xml:space="preserve">2</m:t></m:r></m:sup></m:sSup></m:oMath><w:r><w:t xml:space="preserve"> and, hence, 2 divides </w:t></w:r><m:oMath><m:r><m:t xml:space="preserve">q</m:t></m:r><m:r><m:rPr><m:nor/></m:rPr><m:t xml:space="preserve">.</m:t></m:r></m:oMath><w:r><w:t xml:space="preserve"> This is a contradiction as we assumed </w:t></w:r><m:oMath><m:r><m:t xml:space="preserve">p</m:t></m:r></m:oMath><w:r><w:t xml:space="preserve"> and </w:t></w:r><m:oMath><m:r><m:t xml:space="preserve">q</m:t></m:r></m:oMath><w:r><w:t xml:space="preserve"> were written so that they share no common divisors (other than the trivial divisor 1, of course). Therefore, </w:t></w:r><m:oMath><m:rad><m:radPr><m:degHide m:val="1"/></m:radPr><m:deg/><m:e><m:r><m:rPr><m:nor/></m:rPr><m:t xml:space="preserve">2</m:t></m:r></m:e></m:rad></m:oMath><w:r><w:t xml:space="preserve"> is not a rational number.</w:t></w:r><w:r><w:t xml:space="preserve"> □</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="Heading2"/></w:pPr><w:r><w:t xml:space="preserve">Part b)</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="Normal"/></w:pPr><w:r><w:t xml:space="preserve">To prove the claim of the problem, note that...</w:t></w:r></w:p><w:sectPr><w:pgSz w:w="12240" w:h="15840"/><w:pgMar w:top="1440" w:right="1440" w:bottom="1440" w:left="1440" w:header="720" w:footer="720"/></w:sectPr></w:body></w:document>