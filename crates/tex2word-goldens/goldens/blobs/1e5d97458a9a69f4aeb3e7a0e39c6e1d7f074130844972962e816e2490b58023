r><w:fldChar w:fldCharType="end"/></w:r><w:r><w:t xml:space="preserve">, the conformal test maintains validity even when the classifier is weak, since the ranking signal </w:t></w:r><m:oMath><m:m><m:mr><m:e><m:r><m:rPr><m:nor/></m:rPr><m:t xml:space="preserve">rank</m:t></m:r></m:e></m:mr><m:mr><m:e><m:r><m:rPr><m:nor/></m:rPr><m:t xml:space="preserve">⟶</m:t></m:r></m:e></m:mr></m:m></m:oMath><w:r><w:t xml:space="preserve"> aggregates across draws.</w:t></w:r></w:p><w:sectPr><w:pgSz w:w="12240" w:h="15840"/><w:pgMar w:top="1440" w:right="1440" w:bottom="1440" w:left="1440" w:header="720" w:footer="720"/></w:sectPr></w:body></w:document>