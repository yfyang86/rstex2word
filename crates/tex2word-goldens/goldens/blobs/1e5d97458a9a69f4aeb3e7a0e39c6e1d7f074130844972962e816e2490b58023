></m:oMath><w:r><w:t xml:space="preserve"> and the expectation </w:t></w:r><m:oMath><m:r><m:rPr><m:nor/><m:scr m:val="double-struck"/><m:sty m:val="p"/></m:rPr><m:t xml:space="preserve">E</m:t></m:r><m:r><m:t xml:space="preserve">[</m:t></m:r><m:r><m:t xml:space="preserve">r</m:t></m:r><m:r><m:t xml:space="preserve">]</m:t></m:r></m:oMath><w:r><w:t xml:space="preserve"> of the rank statistic under the null.</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="Normal"/></w:pPr><w:r><w:rPr><w:b/></w:rPr><w:t xml:space="preserve">Theorem</w:t></w:r><w:r><w:rPr><w:b/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:bookmarkStart w:id="1" w:name="thm_decouple"/><w:r><w:fldChar w:fldCharType="begin"/></w:r><w:r><w:instrText xml:space="preserve">SEQ Theorem \* ARABIC</w:instrText></w:r><w:r><w:fldChar w:fldCharType="separate"/></w:r><w:r><w:t xml:space="preserve">1</w:t></w:r><w:r><w:fldChar w:fldCharType="end"/></w:r><w:bookmarkEnd w:id="1"/><w:r><w:t xml:space="preserve"> (</w:t></w:r><w:r><w:rPr><w:b/></w:rPr><w:t xml:space="preserve">Decoupling</w:t></w:r><w:r><w:t xml:space="preserve">)</w:t></w:r><w:r><w:rPr><w:b/></w:rPr><w:t xml:space="preserve">. </w:t></w:r><w:r><w:t xml:space="preserve">For any plug-in classifier with score </w:t></w:r><m:oMath><m:r><m:t xml:space="preserve">s</m:t></m:r></m:oMath><w:r><w:t xml:space="preserve">, the conformal calibration map satisfies</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="Normal"/></w:pPr><m:oMathPara><m:oMath><m:r><m:t xml:space="preserve">|</m:t></m:r><m:r><m:rPr><m:nor/><m:scr m:val="double-struck"/><m:sty m:val="p"/></m:rPr><m:t xml:space="preserve">E</m:t></m:r><m:r><m:t xml:space="preserve">[</m:t></m:r><m:r><m:rPr><m:nor/></m:rPr><m:t xml:space="preserve">ϕ</m:t></m:r><m:r><m:t xml:space="preserve">(</m:t></m:r><m:r><m:t xml:space="preserve">s</m:t></m:r><m:r><m:t xml:space="preserve">)</m:t></m:r><m:r><m:t xml:space="preserve">]</m:t></m:r><m:r><m:t xml:space="preserve">−</m:t></m:r><m:r><m:rPr><m:nor/></m:rPr><m:t xm