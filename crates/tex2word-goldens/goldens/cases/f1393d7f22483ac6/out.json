xt","value":" global minimum of ("},{"@type":"Ref","bookmark":"p3","key":"p3","ref_kind":"equation","style":"plain"},{"@type":"Text","value":")."}]},{"@type":"Paragraph","align":null,"inlines":[{"@type":"Emphasis","inlines":[{"@type":"Text","value":"Problem 2:"}],"kind_":"bold"},{"@type":"Text","value":" You are programming software for the Mars rover. The rover will need to minimize and maximize functions to locate the tops of hills and bottoms of valleys. There is only room for one optimization algorithm in the rover's memory and you must decide between gradient descent and Newton's method. Consider the following function (of a single variable "},{"@type":"Math","latex":"x \\in \\mathbb{R}"},{"@type":"Text","value":") which may resemble a martian valley:"}]},{"@type":"MathBlock","env":"displaymath","label":null,"latex":"f(x) = \\sqrt{x^2 + 1}.","line_labels":[],"numbered":false},{"@type":"ItemList","description":false,"items":[{"@type":"ListItem","blocks":[{"@type":"Paragraph","align":null,"inlines":[{"@type":"Text","value":"Prove that "},{"@type":"Math","latex":"f"},{"@type":"Text","value":" is strictly convex and has a strict global minimum."}]}],"label":null,"term":null},{"@type":"ListItem","blocks":[{"@type":"Paragraph","align":null,"inlines":[{"@type":"Text","value":"Consider gradient descent with step size "},{"@type":"Math","latex":"1"},{"@type":"Text","value":", i.e."}]},{"@type":"MathBlock","env":"displaymath","label":null,"latex":"N(x) = x - f'(x).","line_labels":[],"numbered":false},{"@type":"Paragraph","align":null,"inlines":[{"@type":"Text","value":"For which initializations "},{"@type":"Math","latex":"x_0"},{"@type":"Text","value":" does this method converge, oscillate and diverge? (Hint: Use a Lyapunov function.)"}]}],"label":null,"term":null},{"@type":"ListItem","blocks":[{"@type":"Paragraph","align":null,"inlines":[{"@type":"Text","value":"Consider Newton's method with step size "},{"@type":"Math","latex":"1"},{"@type":"Text","value":", i.e."}]},{"@type":"MathBlock","env":"displaymath","label":null,"latex":"N(x) = x - \\frac{f'(x)}{f''(x)}.","line_labels":[],"numbered":false},{"@type":"Paragraph","align":null,"inlines":[{"@type":"Text","value":"For which initializations "},{"@type":"Math","latex":"x_0"},{"@type":"Text","value":" does this method converge, oscillate and diverge? (Hint: You can run a numerical experiment to get a clue.)"}]}],"label":null,"term":null}],"ordered":true}],"book":false,"labels":{"p3":{"@type":"LabelInfo","bookmark":"p3","counter_name":"Equation","kind":"equation","name":null,"number":null}},"meta":{"@type":"DocumentMeta","abstract":null,"affiliations":[],"authors":[],"cjk_main_font":null,"cjk_mono_font":null,"cjk_sans_font":null,"columns":1,"date":null,"keywords":null,"language":null,"main_font":null,"running_head":null,"title":null}},"report":{"constructs":{"\\ovalbox":1,"titlepage":1},"coverage":{"math_image":0,"math_omml":14,"math_raw":0,"math_total":14},"entries":[{"construct":"titlepage","message":"unknown environment titlepage: treated as transparent","severity":"warning"},{"construct":"\\ovalbox","message":"unsupported inline macro \\ovalbox","severity":"warning"}]}}
