},{"@type":"Text","value":". The first few Legendre polynomials are"}]},{"@type":"MathBlock","env":"displaymath","label":null,"latex":"P_0(x) = 1, \\qquad P_1(x) = x, \\qquad \\text{and} \\qquad P_2(x) = \\frac{3 x^2 - 1}{2}.","line_labels":[],"numbered":false},{"@type":"Paragraph","align":null,"inlines":[{"@type":"Text","value":"The Legendre polynomials obey the recurrence relation"}]},{"@type":"MathBlock","env":"displaymath","label":null,"latex":"(k+1) P_{k+1}(x) = (2 k + 1) x P_k(x) - k P_{k-1}(x),","line_labels":[],"numbered":false},{"@type":"Paragraph","align":null,"inlines":[{"@type":"Text","value":"the differential equation"}]},{"@type":"MathBlock","env":"displaymath","label":null,"latex":"(1 - x^2) P_k''(x) - 2 x P_k'(x) + k(k+1) P_k(x) = 0,","line_labels":[],"numbered":false},{"@type":"Paragraph","align":null,"inlines":[{"@type":"Text","value":"for "},{"@type":"Math","latex":"k \\ge 1"},{"@type":"Text","value":"."}]},{"@type":"Heading","appendix":false,"inlines":[{"@type":"Text","value":"Roots"}],"label":null,"level":2,"numbered":true,"part":false},{"@type":"Paragraph","align":null,"inlines":[{"@type":"Text","value":"More content goes here."}]},{"@type":"Theorem","blocks":[{"@type":"Paragraph","align":null,"inlines":[{"@type":"Text","value":"Can write remarks as well."}]}],"counter":"Remark","kind":"Remark","label":null,"title":null}],"book":false,"labels":{},"meta":{"@type":"DocumentMeta","abstract":null,"affiliations":[],"authors":[[{"@type":"Text","value":"Your Name"}]],"cjk_main_font":null,"cjk_mono_font":null,"cjk_sans_font":null,"columns":1,"date":[{"@type":"Text","value":"January 2, 2026"}],"keywords":null,"language":null,"main_font":null,"running_head":null,"title":[{"@type":"Text","value":"Course supplementary note "},{"@type":"LineBreak"},{"@type":"Text","value":" Gaussian Quadrature"}]}},"report":{"constructs":{},"coverage":{"math_image":0,"math_omml":9,"math_raw":0,"math_total":9},"entries":[]}}
