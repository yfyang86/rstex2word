{"docx":{"order":["[Content_Types].xml","_rels/.rels","docProps/core.xml","word/_rels/document.xml.rels","word/document.xml","word/numbering.xml","word/settings.xml","word/styles.xml","word/tex2word/manifest.json"],"parts":{"[Content_Types].xml":"1f7df72ad5a8f66307467067d77f392b015030286236a9420e0c021328d60c82","_rels/.rels":"0bd96e15a594993ee85a99265cf045c58a5ce173fc3d58d714abb4c7deae0760","docProps/core.xml":"62ca5da8ae2ab12ef090c098a7e97a1c0812065f5f26af1b05febb4bc7261682","word/_rels/document.xml.rels":"ba46c6dca52281714bcf1125b68897f04e361626ad6794567a588ba3b2432c64","word/document.xml":"0be0f08c9caeb0a81efd435355d22153ac9cc37cfbb84c0497a7938b3e99c810","word/numbering.xml":"49a33a4b8fb7ceec1b8d3eff65121417f0b224812a3397450cb1310b0e17bd25","word/settings.xml":"ea591d9abeca1ce9ba6d4b1009e31b413b53d5d564fe38dd08a6e1362e39e1b7","word/styles.xml":"a9cf046d3676e27477640bf260a46a96a0e5dfd04092e827c8ad22700d5211ae","word/tex2word/manifest.json":"a5fd42b68ee04102b98d0b6283b06d7653fe3a7a1c33d498f3d0617ad6391df9"}},"ir":{"@type":"Document","blocks":[{"@type":"Heading","appendix":false,"inlines":[{"@type":"Text","value":"Problem 13.3 of A&A"}],"label":null,"level":1,"numbered":false,"part":false},{"@type":"Heading","appendix":false,"inlines":[{"@type":"Text","value":"Part a)"}],"label":null,"level":2,"numbered":false,"part":false},{"@type":"Theorem","blocks":[{"@type":"Paragraph","align":null,"inlines":[{"@type":"Math","latex":"\\sqrt{2}"},{"@type":"Text","value":" is irrational."}]}],"counter":null,"kind":"Claim","label":null,"title":null},{"@type":"Theorem","blocks":[{"@type":"Paragraph","align":null,"inlines":[{"@type":"Text","value":"Suppose that "},{"@type":"Math","latex":"\\sqrt{2}"},{"@type":"Text","value":" were rational. There there exist some non-zero integers "},{"@type":"Math","latex":"p"},{"@type":"Text","value":" and "},{"@type":"Math","latex":"q"},{"@type":"Text","value":" such that"}]},{"@type":"MathBlock","env":"displaymath","label":null,"latex":"\\sqrt{2} = \\frac{p}{q}.","line_labels":[],"numbered":false},{"@type":"Paragraph","align":null,"inlines":[{"@type":"Text","value":"Without loss of generality, we can assume that this fraction is simplified so that "},{"@type":"Math","latex":"p"},{"@type":"Text","value":" and "},{"@type":"Math","latex":"q"},{"@type":"Text","value":" have no common divisors. Then,"}]},{"@type":"MathBlock","env":"align","label":null,"latex":"\\sqrt{2}q &= p \\\\\n    2q^{2} &= p^{2}.","line_labels":[],"numbered":false},{"@type":"Paragraph","align":null,"inlines":[{"@type":"Text","value":"This implies (by the fundamental theorem of arithmetic) that 2 divides "},{"@type":"Math","latex":"p^{2}"},{"@type":"Text","value":" and, hence, 2 divides "},{"@type":"Math","latex":"p."},{"@type":"Text","value":" Therefore, "},{"@type":"Math","latex":"p = 2r"},{"@type":"Text","value":" for some (non-zero) integer "},{"@type":"Math","latex":"r."},{"@type":"Text","value":" Therefore,"}]},{"@type":"MathBlock","env":"align","label":null,"latex":"2q^{2} &= p^{2} \\\\\n    2q^{2} &= (2r)^{2} \\\\\n    2q^{2} &= 4r^{2} \\\\\n    q^{2} &= 2r^{2}.","line_labels":[],"numbered":false},{"@type":"Paragraph","align":null,"inlines":[{"@type":"Text","value":"From this, we conclude that 2 divides "},{"@type":"Math","latex":"q^{2}"},{"@type":"Text","value":" and, hence, 2 divides "},{"@type":"Math","latex":"q."},{"@type":"Text","value":" This is a contradiction as we assumed "},{"@type":"Math","latex":"p"},{"@type":"Text","value":" and "},{"@type":"Math","latex":"q"},{"@type":"Text","value":" were written so that they share no common divisors (other than the trivial divisor 1, of course). Therefore, "},{"@type":"Math","latex":"\\sqrt{2}"},{"@type":"Text","value":" is not a rational number."}]}],"counter":null,"kind":"Proof","label":null,"title":null},{"@type":"Heading","appendix":false,"inlines":[{"@type":"Text","value":"Part b)"}],"label":null,"level":2,"numbered":false,"part":false},{"@type":"Paragraph","align":null,"inlines":[{"@type":"Text","value":"To prove the claim of the problem, note that..."}]}],"book":false,"labels":{},"meta":{"@type":"DocumentMeta","abstract":null,"affiliations":[],"authors":[[{"@type":"Text","value":"Author Name "},{"@type":"LineBreak"},{"@type":"Text","value":" "},{"@type":"LineBreak"},{"@type":"Text","value":" "},{"@type":"Emphasis","inlines":[{"@type":"Text","value":"Collaborators: Names"}],"kind_":"italic"}]],"cjk_main_font":null,"cjk_mono_font":null,"cjk_sans_font":null,"columns":1,"date":[{"@type":"Text","value":"Due date, or some other relevant date"}],"keywords":null,"language":null,"main_font":null,"running_head":null,"title":[{"@type":"Text","value":" CLASS NAME "},{"@type":"LineBreak"},{"@type":"Text","value":" "},{"@type":"Emphasis","inlines":[{"@type":"Text","value":"Assignment Name"}],"kind_":"bold"}]}},"report":{"constructs":{},"coverage":{"math_image":0,"math_omml":18,"math_raw":0,"math_total":18},"entries":[]}}
